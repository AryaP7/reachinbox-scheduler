# Server
PORT=4000

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public"

# Redis (matches docker-compose.yml)
REDIS_URL="redis://localhost:6379"

# Worker / throughput
WORKER_CONCURRENCY=5
# Minimum delay between two sends from the same sender (ms). Default: 2000 (2s)
MIN_SEND_DELAY_MS=2000
# Hard cap of emails per hour per sender (Redis-backed, safe across instances)
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# How many Ethereal sender accounts to auto-provision on first boot
SENDER_COUNT=3

# Google OAuth (same client ID as the frontend). Used to verify ID tokens on API requests.
GOOGLE_CLIENT_ID=""
# Set to "true" to skip auth locally (e.g. testing with curl)
AUTH_DISABLED=false
