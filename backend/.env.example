# Server
PORT=4000

# PostgreSQL — matches docker-compose.yml, or a native install with the same creds
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public"

# Redis (matches docker-compose.yml)
REDIS_URL="redis://localhost:6379"

# --- Throughput defaults -----------------------------------------------------
# These four are also editable live from the dashboard Settings page (admins
# only); a saved override is stored in the DB and takes precedence over the
# value here. Reset an override to fall back to these.

# How many jobs one worker runs in parallel (restart to apply)
WORKER_CONCURRENCY=5
# Minimum gap between two sends from the same sender (ms). Default: 2000 (2s)
MIN_SEND_DELAY_MS=2000
# Hard cap of emails per hour per sender (Redis-backed, safe across instances)
MAX_EMAILS_PER_HOUR_PER_SENDER=100
# How many Ethereal sender accounts to auto-provision on boot (restart to apply)
SENDER_COUNT=3

# --- Auth / RBAC -------------------------------------------------------------
# Google OAuth client ID — must match the frontend's. Used to verify ID tokens.
GOOGLE_CLIENT_ID=""
# Set to "true" to skip auth locally (acts as a demo ADMIN user)
AUTH_DISABLED=false
# Comma-separated emails seeded as ADMIN on first sign-in.
# If left blank, the very first user to sign in becomes ADMIN.
ADMIN_EMAILS=""

# --- Attachments -------------------------------------------------------------
MAX_ATTACHMENT_BYTES=5242880
MAX_ATTACHMENTS_TOTAL_BYTES=15728640
